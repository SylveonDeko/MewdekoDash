# ========================================
# Mewdeko Dashboard Environment Variables
# ========================================
# Copy this file to .env and fill in your values.
# Required fields are marked with * REQUIRED.

# ========================================
# DISCORD OAUTH
# ========================================
# Create an OAuth2 application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=""           # * REQUIRED
DISCORD_CLIENT_SECRET=""       # * REQUIRED
DISCORD_SCOPES="identify guilds"
DISCORD_REDIRECT_URI="http://localhost:5173/api/discord/callback"  # * REQUIRED - change to your public URL in production
DISCORD_API_URL="https://discordapp.com/api"

# ========================================
# SESSION / COOKIES
# ========================================
# Generate a secure random string (32+ characters)
COOKIE_ENCRYPTION_PASSWORD=""  # * REQUIRED

# ========================================
# BOT API CONNECTION
# ========================================
# The base URL of the running Mewdeko bot API (set in credentials.json ApiPort)
PUBLIC_MEWDEKO_API_URL="http://localhost:5001/botapi"  # * REQUIRED
# Must match ApiKey in the bot's credentials.json
MEWDEKO_API_KEY=""             # * REQUIRED

# ========================================
# JWT (Dashboard identity)
# ========================================
# Must match JwtSecret in the bot's credentials.json so the bot can verify dashboard user tokens
BOT_JWT_SECRET=""              # * REQUIRED

# ========================================
# REDIS (Session storage)
# ========================================
USE_REDIS=true
REDIS_URL="127.0.0.1"
# Must match the prefix used by the bot instance
REDIS_KEY=""                   # * REQUIRED if USE_REDIS=true

# ========================================
# NODE ENVIRONMENT
# ========================================
NODE_ENV=production

# ========================================
# OPTIONAL: Error tracking
# ========================================
# Sentry DSN is public/safe to expose client-side
PUBLIC_SENTRY_DSN=""
PUBLIC_SENTRY_ENVIRONMENT="production"

# ========================================
# OPTIONAL: Patreon integration
# ========================================
PATREON_CLIENT_ID=""
PATREON_CLIENT_SECRET=""

# ========================================
# OPTIONAL: top.gg integration
# ========================================
TOPGG_KEY=""
