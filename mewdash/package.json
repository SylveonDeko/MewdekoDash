{
  "name": "mewdash",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev --force --host",
    "build": "npm run generate-tab-index && npm run generate-sitemap && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . --ext .js,.ts,.svelte",
    "lint:fix": "eslint . --ext .js,.ts,.svelte --fix",
    "format": "prettier --write --plugin-search-dir . .",
    "generate-sitemap": "node generate-sitemap.js",
    "generate-tab-index": "node generate-tab-index.js",
    "check-tab-index": "node generate-tab-index.js --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sveltejs/adapter-node": "^5.3.3",
    "@sveltejs/kit": "^2.45.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/crypto-js": "^4.2.2",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^24.7.0",
    "@types/showdown": "^2.0.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "axios": "^1.12.2",
    "colorthief": "^2.6.0",
    "cookie": "^1.0.2",
    "crypto-js": "^4.2.0",
    "discord-api-types": "^0.38.29",
    "discord-oauth2": "^2.12.1",
    "dompurify": "^3.2.7",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-svelte": "^3.12.4",
    "ioredis": "^5.8.1",
    "json-bigint": "^1.0.0",
    "marked": "^16.4.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "showdown": "^2.1.0",
    "svelte": "^5.39.9",
    "svelte-check": "^4.3.2",
    "svelte-icons-pack": "^3.1.3",
    "svelte-preprocess": "^6.0.3",
    "svelte-turnstile": "^0.11.0",
    "tailwindcss": "^4.1.14",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-mkcert": "^2.1.0"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@sentry/sveltekit": "^10.53.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "discord.css": "^0.4.0",
    "glob": "^11.0.3",
    "nanoid": "^5.1.6",
    "node-vibrant": "^4.0.3",
    "sitemap": "^8.0.0",
    "svelte-dnd-action": "^0.9.65",
    "svelte-persisted-store": "^0.12.0",
    "ws": "^8.18.3"
  }
}
